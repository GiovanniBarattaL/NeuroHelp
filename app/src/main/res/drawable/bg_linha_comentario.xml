<?xml version="1.0" encoding="utf-8"?>
<!-- Campo "Digite seu comentário": só a linha verde embaixo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#47C777" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
