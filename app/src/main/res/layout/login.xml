<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Rola quando a tela é baixa (paisagem, teclado aberto, fonte grande); centraliza quando sobra espaço -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:id="@+id/conteudoLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="56dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="EspectroCare"
            android:maxWidth="250dp"
            android:maxHeight="216dp"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/nunito_black"
            android:gravity="center"
            android:text="Bem-vindo(a)!"
            android:textColor="#04344E"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="4dp"
            android:maxWidth="300dp"
            android:fontFamily="@font/nunito_black"
            android:gravity="center"
            android:text="Faça login para acessar uma experiência feita para você e seu filho"
            android:textColor="#04344E"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/botoesTipoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPai"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="13dp"
                android:layout_weight="1"
                android:background="@drawable/botao_gradiente"
                android:text="Sou pai/mãe"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="10dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="center"
                android:fontFamily="@font/nunito_black"
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <Button
                android:id="@+id/btnProfissional"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/botao_branco"
                android:ellipsize="none"
                android:gravity="center"
                android:text="Sou profissional"
                android:textAllCaps="false"
                android:textColor="#04344E"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:fontFamily="@font/nunito_black"
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:textColorHint="#9C9C9C"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/textinput_stroke"
            app:cursorColor="#47C777"
            app:hintEnabled="true"
            app:hintTextColor="#47C777"
            app:placeholderTextColor="#47C777">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="E-mail"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:textColor="#04344E"
                android:textColorHint="#8A8A8A"
                android:textColorHighlight="#4747C777"
                android:textColorLink="#47C777"
                android:textSelectHandle="@drawable/cursor_handle_meio"
                android:textSelectHandleLeft="@drawable/cursor_handle_esquerda"
                android:textSelectHandleRight="@drawable/cursor_handle_direita"
                app:cursorColor="#47C777"
                android:singleLine="true"
                android:minHeight="48dp"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:autofillHints="emailAddress"     android:maxLength="254"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:textColorHint="#9C9C9C"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/textinput_stroke"
            app:cursorColor="#47C777"
            app:hintEnabled="true"
            app:hintTextColor="#47C777"
            app:placeholderTextColor="#47C777"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Senha"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:textColor="#04344E"
                android:textColorHint="#8A8A8A"
                android:textColorHighlight="#4747C777"
                android:textColorLink="#47C777"
                android:textSelectHandle="@drawable/cursor_handle_meio"
                android:textSelectHandleLeft="@drawable/cursor_handle_esquerda"
                android:textSelectHandleRight="@drawable/cursor_handle_direita"
                app:cursorColor="#47C777"
                android:singleLine="true"
                android:minHeight="48dp"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:autofillHints="password" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:id="@+id/txtEsqueciSenha"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito"
            android:text="Esqueci minha senha"
            android:textColor="#47C777"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEntrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/botao_gradiente"
            android:text="Entrar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="10dp"
            android:minHeight="48dp"
            android:minWidth="0dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Não tem uma conta? "
                android:textColor="#9C9C9C"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtCriarConta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:text="Criar Conta"
                android:textColor="#47C777"
                android:textStyle="bold"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
