<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FAFAFA"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#ECECEC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Linha da pergunta (sempre visível, clicável) -->
        <LinearLayout
            android:id="@+id/itemPergunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtPergunta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Exemplos de dúvidas frequentes"
                android:textColor="#555555"
                android:textSize="12sp"
                android:fontFamily="@font/nunito" />

            <ImageView
                android:id="@+id/imgSeta"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_seta_direita"
                app:tint="#9C9C9C" />

        </LinearLayout>

        <!-- Resposta (some/aparece ao clicar) -->
        <TextView
            android:id="@+id/txtResposta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="3dp"
            android:text="Resposta da dúvida frequente."
            android:textColor="#555555"
            android:textSize="11sp"
            android:fontFamily="@font/nunito"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
