<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/privacidadeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tela_fundo_claro"
    tools:context=".Perfil.FragmentPrivacidade">

    <include
        android:id="@+id/header"
        layout="@layout/header_padrao"
        android:layout_width="match_parent"
        android:layout_height="@dimen/altura_cabecalho"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPrivacidade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:descendantFocusability="afterDescendants"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="0dp"
            android:paddingBottom="24dp">

            <!-- TÍTULO DA TELA (o voltar fica no cabeçalho padrão) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito_black"
                android:gravity="center"
                android:text="Privacidade e Segurança"
                android:textColor="@color/azul_titulo"
                android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Responsável"
            android:src="@drawable/ic_secao_responsavel" />

        <TextView style="@style/TituloSecaoPerfil" android:layout_marginStart="6dp" android:text="Informações do responsável"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4.5dp"
            android:layout_weight="3"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_pessoa" />

            <EditText
                android:id="@+id/etRespNome"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="XXXXXXXXXXXX"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4.5dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_pessoa" />

            <EditText
                android:id="@+id/etRespSexo"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="Fem"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_telefone" />

            <EditText
                android:id="@+id/etRespTelefone"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="(11) 99999-9999"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content"     android:maxLength="11"
                    android:digits="0123456789"
                />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_cpf" />

            <EditText
                android:id="@+id/etRespCpf"
                    android:maxLength="11"
                    android:digits="0123456789"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="***.***.***-**"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4.5dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_calendario" />

            <EditText
                android:id="@+id/etRespDataNasc"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="dd/mm/aaaa"
                android:importantForAutofill="no"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content"     android:maxLength="10"
                    android:inputType="date"
                />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4.5dp"
            android:layout_weight="3"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_local" />

            <EditText
                android:id="@+id/etRespCidade"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="Rio de Janeiro"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4.5dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_cadeado" />

            <EditText
                android:id="@+id/etRespUf"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="RJ"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content"     android:maxLength="2"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnEditarResponsavel"
        style="@style/BotaoEditarPerfil"
        android:layout_gravity="end"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Dependente"
            android:src="@drawable/ic_secao_dependente" />

        <TextView style="@style/TituloSecaoPerfil" android:layout_marginStart="6dp" android:text="Informações do dependente"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_pessoa" />

            <EditText
                android:id="@+id/etDepNome"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="XXXXXXXXXXX"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_cpf" />

            <EditText
                android:id="@+id/etDepCpf"
                    android:maxLength="11"
                    android:digits="0123456789"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="***.***.***-**"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4.5dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_pessoa" />

            <EditText
                android:id="@+id/etDepSexo"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="Masc"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_calendario" />

            <EditText
                android:id="@+id/etDepDataNasc"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="dd/mm/aaaa"
                android:importantForAutofill="no"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content"     android:maxLength="10"
                    android:inputType="date"
                />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/nunito_black"
        android:text="Ele/ela possui diagnóstico?"
        android:textColor="@color/azul_titulo"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/checkDiagSim"
            style="@style/CheckDiagnostico"
            android:enabled="false"
            android:checked="true"
            android:text="Sim, possui diagnóstico" />

        <CheckBox
            android:id="@+id/checkDiagAnalise"
            style="@style/CheckDiagnostico"
            android:enabled="false"
            android:text="Não, mas está em análise" />

        <CheckBox
            android:id="@+id/checkDiagNao"
            style="@style/CheckDiagnostico"
            android:enabled="false"
            android:text="Não, não possui diagnóstico" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnEditarDependente"
        style="@style/BotaoEditarPerfil"
        android:layout_gravity="end"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Segurança"
            android:src="@drawable/ic_secao_seguranca" />

        <TextView style="@style/TituloSecaoPerfil" android:layout_marginStart="6dp" android:text="Segurança"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_email" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="xxx******@gmail.com"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content"     android:maxLength="254"
                />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_cadeado" />

            <EditText
                android:id="@+id/etSenha"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="************"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true"
                android:minHeight="48dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnEditarSeguranca"
        style="@style/BotaoEditarPerfil"
        android:layout_gravity="end"
        android:layout_marginTop="14dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
