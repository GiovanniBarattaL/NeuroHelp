<?xml version="1.0" encoding="utf-8"?>
<!-- Tela Privacidade e Segurança — layout conforme o Figma -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/privacidadeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tela_fundo_claro"
    tools:context=".Perfil.FragmentPrivacidade">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPrivacidade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="30dp"
            android:paddingBottom="24dp">

            <!-- CABEÇALHO: seta de voltar + título centralizado -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="60dp">

                <ImageView
                    android:id="@+id/imgVoltar"
                    style="@style/BotaoVoltar"
                    android:layout_gravity="top|start" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:fontFamily="@font/nunito_black"
                    android:text="Privacidade e Segurança"
                    android:textColor="@color/azul_titulo"
                    android:textSize="18sp" />
            </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Responsável"
            android:src="@drawable/ic_secao_responsavel" />

        <TextView
            style="@style/TituloSecaoPerfil"
            android:layout_marginStart="6dp"
            android:text="Informações do responsável" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4.5dp"
            android:layout_weight="3"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_pessoa" />

            <EditText
                android:id="@+id/etRespNome"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="XXXXXXXXXXXX"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4.5dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_pessoa" />

            <EditText
                android:id="@+id/etRespSexo"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="Fem"
                android:importantForAutofill="no"
                android:inputType="text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_telefone" />

            <EditText
                android:id="@+id/etRespTelefone"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="(11) 99999-9999"
                android:importantForAutofill="no"
                android:inputType="phone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_cpf" />

            <EditText
                android:id="@+id/etRespCpf"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="***.***.***-**"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4.5dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_calendario" />

            <EditText
                android:id="@+id/etRespDataNasc"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="dd/mm/aaaa"
                android:importantForAutofill="no"
                android:inputType="date" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4.5dp"
            android:layout_weight="3"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_local" />

            <EditText
                android:id="@+id/etRespCidade"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="Rio de Janeiro"
                android:importantForAutofill="no"
                android:inputType="textCapWords" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4.5dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_cadeado" />

            <EditText
                android:id="@+id/etRespUf"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="RJ"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters"
                android:maxLength="2" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnEditarResponsavel"
        style="@style/BotaoEditarPerfil"
        android:layout_gravity="end"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Dependente"
            android:src="@drawable/ic_secao_dependente" />

        <TextView
            style="@style/TituloSecaoPerfil"
            android:layout_marginStart="6dp"
            android:text="Informações do dependente" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_pessoa" />

            <EditText
                android:id="@+id/etDepNome"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="XXXXXXXXXXX"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_cpf" />

            <EditText
                android:id="@+id/etDepCpf"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="***.***.***-**"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4.5dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_pessoa" />

            <EditText
                android:id="@+id/etDepSexo"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="Masc"
                android:importantForAutofill="no"
                android:inputType="text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_calendario" />

            <EditText
                android:id="@+id/etDepDataNasc"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="dd/aa/mmmm"
                android:importantForAutofill="no"
                android:inputType="date" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/nunito_black"
        android:text="Ele/ela possui diagnóstico?"
        android:textColor="@color/azul_titulo"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/checkDiagSim"
            style="@style/CheckDiagnostico"
            android:enabled="false" 
            android:checked="true"
            android:text="Sim, possui diagnóstico" />

        <CheckBox
            android:id="@+id/checkDiagAnalise"
            style="@style/CheckDiagnostico"
            android:enabled="false"
            android:text="Não, mas está em análise" />

        <CheckBox
            android:id="@+id/checkDiagNao"
            style="@style/CheckDiagnostico"
            android:enabled="false"
            android:text="Não, não possui diagnóstico" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnEditarDependente"
        style="@style/BotaoEditarPerfil"
        android:layout_gravity="end"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Segurança"
            android:src="@drawable/ic_secao_seguranca" />

        <TextView
            style="@style/TituloSecaoPerfil"
            android:layout_marginStart="6dp"
            android:text="Segurança" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_email" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="xxx******@gmail.com"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo_perfil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_cadeado" />

            <EditText
                android:id="@+id/etSenha"
                style="@style/CampoPerfil"
                android:enabled="false"
                android:hint="************"
                android:importantForAutofill="no"
                android:inputType="textPassword" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnEditarSeguranca"
        style="@style/BotaoEditarPerfil"
        android:layout_gravity="end"
        android:layout_marginTop="14dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
