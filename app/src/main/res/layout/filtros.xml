<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:paddingStart="10dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ESPECIALIDADE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Especialidade"
            android:textColor="#35C979"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_black" />

        <CheckBox
            android:id="@+id/checkEspecialidade1"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="Exemplo de Especialidade"
            android:textSize="9sp"
            android:textColor="#000000"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/checkEspecialidade2"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="Exemplo de Especialidade"
            android:textSize="9sp"
            android:textColor="#000000"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/checkEspecialidade3"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="Exemplo de Especialidade"
            android:textSize="9sp"
            android:textColor="#000000"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/checkEspecialidade4"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="Exemplo de Especialidade"
            android:textSize="9sp"
            android:textColor="#000000"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/checkEspecialidade5"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="Exemplo de Especialidade"
            android:textSize="9sp"
            android:textColor="#000000"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <!-- TIPO DE ATENDIMENTO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Tipo de atendimento"
            android:textColor="#35C979"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_black" />

        <CheckBox
            android:id="@+id/checkOnline"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="Online"
            android:textSize="9sp"
            android:textColor="#000000"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/checkPresencial"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="Presencial"
            android:textSize="9sp"
            android:textColor="#000000"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/checkHibrido"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="Híbrido"
            android:textSize="9sp"
            android:textColor="#000000"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <!-- LOCALIZAÇÃO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Localização"
            android:textColor="#35C979"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_black" />

        <Spinner
            android:id="@+id/spinnerCidade"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="4dp" />

        <!-- AVALIAÇÃO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Avaliação"
            android:textColor="#35C979"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="@font/nunito_black" />

        <CheckBox
            android:id="@+id/check5Estrelas"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="★★★★★  (5)"
            android:textColor="#FFA500"
            android:textSize="9sp"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/check4Estrelas"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="★★★★☆  (4)"
            android:textColor="#FFA500"
            android:textSize="9sp"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/check3Estrelas"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="★★★☆☆  (3)"
            android:textColor="#FFA500"
            android:textSize="9sp"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/check2Estrelas"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="★★☆☆☆  (2)"
            android:textColor="#FFA500"
            android:textSize="9sp"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <CheckBox
            android:id="@+id/check1Estrela"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="★☆☆☆☆  (1)"
            android:textColor="#FFA500"
            android:textSize="9sp"
            android:fontFamily="@font/nunito"
            android:padding="0dp" />

        <!-- APLICAR FILTROS -->

        <TextView
            android:id="@+id/btnAplicarFiltros"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/botao_gradiente"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:text="Aplicar Filtros"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- LIMPAR FILTROS -->

        <TextView
            android:id="@+id/btnLimparFiltros"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_btn_perfil"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:text="Limpar Filtros"
            android:textColor="#073B5C"
            android:textSize="8sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>