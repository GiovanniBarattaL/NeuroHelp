<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/privacidadeProfRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tela_fundo_claro"
    tools:context=".Perfil.FragmentPrivacidadeProfissional">

    <include
        android:id="@+id/header"
        layout="@layout/header_padrao"
        android:layout_width="match_parent"
        android:layout_height="@dimen/altura_cabecalho"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPrivacidadeProf"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:descendantFocusability="afterDescendants"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- Margens laterais por tamanho de tela (@dimen/margem_tela) e largura máxima em tablet -->
        <LinearLayout
            android:id="@+id/conteudoPrivacidadeProf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito_black"
                android:gravity="center"
                android:text="Privacidade e Segurança"
                android:textColor="@color/azul_titulo"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margem_tela_formulario">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Informações pessoais"
            android:src="@drawable/ic_secao_responsavel" />

        <TextView style="@style/TituloSecaoPerfil" android:layout_marginStart="6dp" android:text="Informações pessoais"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_pessoa" />

                <EditText
                    android:id="@+id/etProfNome"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="Nome completo"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_telefone" />

                <EditText
                    android:id="@+id/etProfTelefone"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="(11) 99999-9999"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:singleLine="true"     android:maxLength="11"
                    android:digits="0123456789"
                />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_cpf" />

                <EditText
                    android:id="@+id/etProfCpf"
                    android:maxLength="11"
                    android:digits="0123456789"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="***.***.***-**"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_calendario" />

                <EditText
                    android:id="@+id/etProfDataNasc"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="Data de Nasc."
                    android:importantForAutofill="no"
                    android:singleLine="true"     android:maxLength="10"
                    android:inputType="date"
                />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btnEditarProfPessoais"
        style="@style/BotaoEditarPerfil"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="0dp"
        android:minHeight="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Endereço"
            android:src="@drawable/ic_secao_endereco" />

        <TextView style="@style/TituloSecaoPerfil" android:layout_marginStart="6dp" android:text="Endereço"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:labelFor="@id/etProfCep"
                android:text="CEP"
                android:textColor="@color/agenda_texto_secundario"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etProfCep"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="00000-000"
                    android:importantForAutofill="no"
                    android:singleLine="true"     android:maxLength="8"
                    android:digits="0123456789"
                    android:inputType="number"
                />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:labelFor="@id/etProfUf"
                android:text="UF"
                android:textColor="@color/agenda_texto_secundario"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etProfUf"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="SP"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:singleLine="true"     android:maxLength="2"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:labelFor="@id/etProfCidade"
                android:text="Cidade"
                android:textColor="@color/agenda_texto_secundario"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etProfCidade"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="São Paulo"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:labelFor="@id/etProfBairro"
                android:text="Bairro"
                android:textColor="@color/agenda_texto_secundario"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etProfBairro"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="Bairro"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:labelFor="@id/etProfLogradouro"
                android:text="Logradouro"
                android:textColor="@color/agenda_texto_secundario"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etProfLogradouro"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="Rua, avenida..."
                    android:importantForAutofill="no"
                    android:inputType="textPostalAddress"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:labelFor="@id/etProfNumero"
                android:text="Nº Residencial"
                android:textColor="@color/agenda_texto_secundario"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etProfNumero"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="598"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btnEditarProfEndereco"
        style="@style/BotaoEditarPerfil"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="0dp"
        android:minHeight="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Formação profissional"
            android:src="@drawable/ic_secao_formacao" />

        <TextView style="@style/TituloSecaoPerfil" android:layout_marginStart="6dp" android:text="Formação profissional"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etProfFormacao"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="Ex.: Psicólogo(a) · CRP 06/123456"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btnEditarProfFormacao"
        style="@style/BotaoEditarPerfil"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="0dp"
        android:minHeight="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Documentos"
            android:src="@drawable/ic_secao_documentos" />

        <TextView style="@style/TituloSecaoPerfil" android:layout_marginStart="6dp" android:text="Documentos"/>
    </LinearLayout>

    <!-- Área de envio do documento: só responde ao toque depois de tocar em "Editar" -->
    <LinearLayout
        android:id="@+id/areaDocumentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_upload_documento"
        android:clickable="true"
        android:contentDescription="Enviar documento"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="120dp"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_upload_nuvem" />

        <TextView
            android:id="@+id/txtArquivoDocumento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="middle"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:maxLines="2"
            android:text="Nenhum arquivo selecionado"
            android:textColor="@color/agenda_texto_secundario"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito"
            android:text="* Caso necessário, faça a atualização documental aqui"
            android:textColor="@color/agenda_texto_secundario"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnEditarProfDocumentos"
            style="@style/BotaoEditarPerfil"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="0dp"
            android:minHeight="32dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Segurança"
            android:src="@drawable/ic_secao_seguranca" />

        <TextView style="@style/TituloSecaoPerfil" android:layout_marginStart="6dp" android:text="Segurança"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_email" />

                <EditText
                    android:id="@+id/etProfEmail"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="xxx******@gmail.com"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"     android:maxLength="254"
                />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_campo_cadeado" />

                <EditText
                    android:id="@+id/etProfSenha"
                    style="@style/CampoPerfil"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="48dp"
                    android:enabled="false"
                    android:hint="************"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btnEditarProfSeguranca"
        style="@style/BotaoEditarPerfil"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="0dp"
        android:minHeight="32dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
