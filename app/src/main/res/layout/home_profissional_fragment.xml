<?xml version="1.0" encoding="utf-8"?>
<!--
    HOME DO PROFISSIONAL (Figma "Group 233"): mesma estrutura da home_fragment, com conteúdo para quem atende.

    RESPONSIVIDADE
    - Cabeçalho: altura + barra de status somadas em configurarCabecalhoPadrao (sem margem fixa).
    - Margens, tamanhos de texto e proporção do banner vêm de @dimen (values / values-sw600dp / values-sw840dp).
    - Conteúdo fica centralizado com largura máxima em tablets (FragmentHomeProfissional).
    - Os 3 cards de aprendizagem viram uma coluna em telas estreitas ou com fonte muito grande (FragmentHomeProfissional).
    - A consulta usa duas linhas (paciente / data e horário) para não espremer o nome em telas estreitas.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeProfissionalRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Home.FragmentHomeProfissional">

    <!-- HEADER PADRÃO -->
    <include
        android:id="@+id/header"
        layout="@layout/header_padrao"
        android:layout_width="match_parent"
        android:layout_height="@dimen/altura_cabecalho"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollHomeProfissional"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:id="@+id/conteudoHomeProfissional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- BANNER -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bannerHomeProfissional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8F8F8">

                <LinearLayout
                    android:id="@+id/layoutBoasVindas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margem_tela"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="@dimen/home_banner_texto_margem_inferior"
                    android:orientation="vertical"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/imgBannerProfissional"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0">

                    <TextView
                        android:id="@+id/txtBoasVindas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito_black"
                        android:maxLines="2"
                        android:text="Olá!"
                        android:textColor="#04344E"
                        android:textSize="@dimen/home_titulo_tamanho"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nunito"
                        android:text="Estamos aqui para conectar você a famílias que precisam do seu cuidado."
                        android:textColor="#04344E"
                        android:textSize="@dimen/home_subtitulo_tamanho"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Largura = % da tela (0,5 no celular, menor em tablet) para a imagem não ficar gigante -->
                <ImageView
                    android:id="@+id/imgBannerProfissional"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="@dimen/home_banner_margem_inferior"
                    android:adjustViewBounds="true"
                    android:contentDescription="Profissional atendendo uma criança"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_profissional_banner"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="@dimen/home_banner_imagem_percent" />

                <ImageView
                    android:id="@+id/imgCurva"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_curva_home"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--
                BLOCO CENTRAL: tudo abaixo do banner. Em tablets o FragmentHomeProfissional limita a largura
                (padding lateral) para o conteúdo não esticar. A sobreposição ao banner (-44dp) fica NO bloco,
                assim a parte do card sobre o banner continua clicável.
            -->
            <LinearLayout
                android:id="@+id/blocoConteudo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-44dp"
                android:orientation="vertical">

            <!-- CARD APRENDIZAGEM (sobrepõe o banner) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAprendizagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margem_tela"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#E8E8E8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/btnAprendizagem"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="Aprendizagem"
                            android:src="@drawable/ic_blog" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/nunito"
                            android:text="Aprendizagem"
                            android:textColor="#555555"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Divisor: acompanha a altura do conteúdo (texto pode quebrar em mais linhas) -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="14dp"
                        android:layout_marginVertical="2dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito"
                        android:text="Olhe nossa página de aprendizagem! Mande sua opinião para nossos colaboradores."
                        android:textColor="#555555"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CONTEÚDOS DE APRENDIZAGEM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margem_tela"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_black"
                    android:text="Conteúdos de Aprendizagem"
                    android:textColor="#04344E"
                    android:textSize="@dimen/home_secao_tamanho"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtVerTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/nunito"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:padding="4dp"
                    android:text="Ver todos →"
                    android:textColor="#757575"
                    android:textSize="12sp" />

            </LinearLayout>

            <!--
                3 CARDS lado a lado, todos com a mesma altura.
                Em telas estreitas / fonte grande o FragmentHomeProfissional troca para coluna.
            -->
            <LinearLayout
                android:id="@+id/listaConteudos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/margem_tela"
                android:paddingTop="4dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardConteudoTea"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#F2FAFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#DCEFFA"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="@dimen/home_card_icone"
                            android:layout_height="@dimen/home_card_icone"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_cerebro_card" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:breakStrategy="simple"
                            android:fontFamily="@font/nunito_black"
                            android:hyphenationFrequency="normal"
                            android:text="Entendendo o TEA"
                            android:textColor="#04344E"
                            android:textSize="@dimen/home_card_titulo_tamanho" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/nunito"
                            android:hyphenationFrequency="normal"
                            android:text="O que é, principais características e sinais de alerta."
                            android:textColor="#555555"
                            android:textSize="@dimen/home_card_texto_tamanho" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardConteudoEstrategias"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#F0FFF6"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D6F5E2"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="@dimen/home_card_icone"
                            android:layout_height="@dimen/home_card_icone"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_maos" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:breakStrategy="simple"
                            android:fontFamily="@font/nunito_black"
                            android:hyphenationFrequency="normal"
                            android:text="Estratégias para o dia a dia"
                            android:textColor="#04344E"
                            android:textSize="@dimen/home_card_titulo_tamanho" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/nunito"
                            android:hyphenationFrequency="normal"
                            android:text="Dicas práticas para rotina, comunicação e comportamento."
                            android:textColor="#555555"
                            android:textSize="@dimen/home_card_texto_tamanho" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardConteudoEscola"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#F2FAFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#DCEFFA"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="@dimen/home_card_icone"
                            android:layout_height="@dimen/home_card_icone"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_escola" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:breakStrategy="simple"
                            android:fontFamily="@font/nunito_black"
                            android:hyphenationFrequency="normal"
                            android:text="Inclusão escolar"
                            android:textColor="#04344E"
                            android:textSize="@dimen/home_card_titulo_tamanho" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/nunito"
                            android:hyphenationFrequency="normal"
                            android:text="Como apoiar o desenvolvimento da criança na escola."
                            android:textColor="#555555"
                            android:textSize="@dimen/home_card_texto_tamanho" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- PRÓXIMAS CONSULTAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margem_tela"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_black"
                    android:text="Próximas consultas"
                    android:textColor="#04344E"
                    android:textSize="@dimen/home_secao_tamanho"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtVerAgenda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/nunito"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:padding="4dp"
                    android:text="Ver agenda →"
                    android:textColor="#757575"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- CARD DA PRÓXIMA CONSULTA (paciente) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProximaConsulta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margem_tela"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#E8E8E8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- LINHA 1: paciente (ocupa todo o espaço que sobra) + seta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgPaciente"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="Paciente"
                            android:scaleType="centerCrop"
                            android:src="@drawable/avatar_perfil" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtNomePaciente"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/nunito_black"
                                android:maxLines="1"
                                android:text="Paciente XXXX"
                                android:textColor="#073B5C"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtCpfPaciente"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/nunito"
                                android:maxLines="1"
                                android:text="CPF XXX.XXX.XXX-XX"
                                android:textColor="#6B6B6B"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- Área de toque de 48dp (ícone visível com 22dp) -->
                        <ImageView
                            android:id="@+id/imgSetaConsulta"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Ver detalhe da consulta"
                            android:focusable="true"
                            android:padding="13dp"
                            android:src="@drawable/botao_ir" />

                    </LinearLayout>

                    <!-- LINHA 2: data à esquerda, horário à direita (não disputa espaço com o nome) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_calendario" />

                            <TextView
                                android:id="@+id/txtDataConsulta"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/nunito"
                                android:maxLines="1"
                                android:text="24 de maio, 2025"
                                android:textColor="#073B5C"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_clock" />

                            <TextView
                                android:id="@+id/txtHorarioConsulta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/nunito"
                                android:maxLines="1"
                                android:text="15:00"
                                android:textColor="#073B5C"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtDetalhesConsulta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/nunito_black"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:padding="2dp"
                        android:text="Ver detalhe da consulta"
                        android:textColor="#1F9E57"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
