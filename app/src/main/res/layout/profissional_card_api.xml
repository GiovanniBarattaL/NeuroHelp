<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/cardProfissional1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#F2F2F2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- CONTEÚDO SUPERIOR -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- FOTO -->
                        <ImageView
                            android:id="@+id/imgAvatar1"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:contentDescription="Profissional"
                            android:scaleType="fitCenter"
                            android:src="@drawable/avatar_verde"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- FAVORITO -->
                        <LinearLayout
                            android:id="@+id/layoutFavorito1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/txtFavorito1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito"
                                android:text="Favoritar"
                                android:textColor="#35C979"
                                android:textSize="10sp" />

                            <ImageView
                                android:id="@+id/imgFavorito1"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="4dp"
                                android:contentDescription="Favoritar"
                                android:src="@drawable/ic_favorito" />

                        </LinearLayout>

                        <!-- INFORMAÇÕES -->
                        <LinearLayout
                            android:id="@+id/infoProfissional"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/imgAvatar1"
                            app:layout_constraintTop_toTopOf="parent">

                            <!-- CRP -->
                            <TextView
                                android:id="@+id/txtcrp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#F2FFF9"
                                android:fontFamily="@font/nunito"
                                android:paddingHorizontal="5dp"
                                android:paddingVertical="1dp"
                                android:text="CRP 06/123456"
                                android:textColor="#35C979"
                                android:textSize="10sp" />

                            <!-- NOME -->
                            <TextView
                                android:id="@+id/txtNome1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/nunito_black"
                                android:maxLines="1"
                                android:text="Dra. XXXXX"
                                android:textColor="#073B5C"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <!-- PROFISSÃO -->
                            <TextView
                                android:id="@+id/txtProfissao1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/nunito"
                                android:maxLines="1"
                                android:text="Psicóloga"
                                android:textColor="#073B5C"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- ATENDIMENTO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgOnline1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_online" />

                        <TextView
                            android:id="@+id/txtOnline1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/nunito"
                            android:maxLines="1"
                            android:text="Atende online e presencial"
                            android:textColor="#073B5C"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- LOCALIZAÇÃO + AVALIAÇÃO (mesma linha) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgLocal1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_localizacao" />

                        <TextView
                            android:id="@+id/txtLocal1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/nunito"
                            android:maxLines="1"
                            android:text="São Paulo - SP"
                            android:textColor="#073B5C"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/layoutAvaliacao1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtEstrelas1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito"
                                android:text="★★★★☆"
                                android:textColor="#FFA914"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/txtAvaliacao1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:fontFamily="@font/nunito"
                                android:text="(97)"
                                android:textColor="#073B5C"
                                android:textSize="10sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- BOTÕES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnPerfil1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_perfil"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/nunito_black"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Ver Perfil"
                            android:textColor="#073B5C"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnAgendar1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/botao_gradiente"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/nunito_black"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Agendar Consulta"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>