<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/consultaDetalheRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".agenda.FragmentConsultaDetalhe">

    <!-- ====================================================== -->
    <!-- HEADER FIXO (voltar + logo + sino + avatar) -->
    <!-- ====================================================== -->
    <include
        android:id="@+id/header"
        layout="@layout/header_padrao"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ====================================================== -->
    <!-- CONTEÚDO ROLÁVEL -->
    <!-- ====================================================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollConsulta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/tela_fundo_claro"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ================= CABEÇALHO DO PROFISSIONAL ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/frameProfissional"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/agenda_verde_escuro">

                    <ImageView
                        android:id="@+id/imgProfissional"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="Profissional"
                        android:src="@drawable/ic_cerebro" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito_black"
                        android:maxLines="2"
                        android:text="Consulta com Psicólogo"
                        android:textColor="@color/azul_titulo"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito"
                        android:maxLines="1"
                        android:text="Dr. XXXXXXXXXX"
                        android:textColor="@color/agenda_verde_escuro"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtProfissao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito"
                        android:maxLines="1"
                        android:text="Psicólogo"
                        android:textColor="@color/agenda_texto_secundario"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtCrp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="#E8FFF2"
                        android:fontFamily="@font/nunito"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="CRP 06/123456"
                        android:textColor="@color/agenda_verde_escuro"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/divisor_claro" />

            <!-- ================= DATA / HORÁRIO / FORMATO / STATUS ================= -->
            <LinearLayout
                android:id="@+id/infoConsulta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- DATA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:contentDescription="Data"
                        android:src="@drawable/ic_data_agenda" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_black"
                            android:text="Data"
                            android:textColor="@color/azul_titulo"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="01 de Abril de 2026\n(Terça-Feira)"
                            android:textColor="@color/agenda_texto_secundario"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/divisor_claro" />

                <!-- HORÁRIO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:contentDescription="Horário"
                        android:src="@drawable/ic_relogio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_black"
                            android:text="Horário"
                            android:textColor="@color/azul_titulo"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtHorario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="14h00"
                            android:textColor="@color/agenda_texto_secundario"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/divisor_claro" />

                <!-- FORMATO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:contentDescription="Formato"
                        android:src="@drawable/ic_camera" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_black"
                            android:text="Formato"
                            android:textColor="@color/azul_titulo"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtFormato"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="Online"
                            android:textColor="@color/agenda_texto_secundario"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@color/divisor_claro" />

                <!-- STATUS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:contentDescription="Status"
                        android:src="@drawable/ic_status" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_black"
                            android:text="Status"
                            android:textColor="@color/azul_titulo"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="Confirmada"
                            android:textColor="@color/agenda_verde_escuro"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/divisor_claro" />

            <!-- ================= SOBRE O(A) PROFISSIONAL ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Sobre o profissional"
                    android:src="@drawable/ic_pessoa_agenda" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_black"
                    android:text="Sobre o(a) profissional"
                    android:textColor="@color/azul_titulo"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Texto de apresentação do profissional (vem do backend) -->
            <TextView
                android:id="@+id/txtSobreProfissional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/nunito"
                android:lineSpacingExtra="2dp"
                android:minHeight="32dp"
                android:textColor="@color/agenda_texto_secundario"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/divisor_claro" />

            <!-- ================= OBSERVAÇÕES DA CONSULTA ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Observações"
                    android:src="@drawable/obs_agenda" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_black"
                        android:text="Observações da consulta"
                        android:textColor="@color/azul_titulo"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtObservacoes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito"
                        android:text="Acompanhamento psicológico semanal"
                        android:textColor="@color/agenda_texto_secundario"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtFoco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/nunito"
                        android:text="Foco: ansiedade e regulação emocional"
                        android:textColor="@color/agenda_verde_escuro"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/divisor_claro" />

            <!-- ================= MOTIVO / DISPOSIÇÃO ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Motivo"
                    android:src="@drawable/obs_agenda" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito"
                    android:lineSpacingExtra="2dp"
                    android:text="Por favor, diga o motivo e/ou qual é sua disposição para a consulta. Assim o profissional pode se preparar melhor."
                    android:textColor="@color/azul_titulo"
                    android:textSize="12sp" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:strokeColor="#EDEDED"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etConsideracoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/nunito"
                    android:gravity="top|start"
                    android:hint="Digite aqui suas considerações."
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="170dp"
                    android:padding="16dp"
                    android:textColor="@color/azul_titulo"
                    android:textColorHint="@color/campo_hint"
                    android:textSize="12sp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- ================= BOTÕES ================= -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSolicitarAlteracoes"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/botao_gradiente"
                android:fontFamily="@font/nunito_black"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Solicitar alterações"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_reagendar"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarConsulta"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#FFFFFF"
                android:fontFamily="@font/nunito"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:text="Cancelar consulta"
                android:textAllCaps="false"
                android:textColor="@color/agenda_verde_escuro"
                android:textSize="13sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_cancelar_consulta"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@null"
                app:strokeColor="@color/agenda_verde"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
