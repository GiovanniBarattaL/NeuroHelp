<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BottomNavigationTextStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="AgendaDiaSemana">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/agenda_texto_secundario</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- ===== Tela Privacidade e Segurança (Figma) ===== -->

    <!-- Campo de texto dentro da "caixa" branca (bg_campo_perfil) -->
    <style name="CampoPerfil">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:padding">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#073B5C</item>
        <item name="android:textColorHint">#9C9C9C</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Botão verde "Editar" (ícone de lápis + texto) -->
    <style name="BotaoEditarPerfil">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginEnd">26dp</item>
        <item name="android:background">@drawable/bg_btn_editar</item>
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableStart">@drawable/ic_lapis_editar</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/nunito_black</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:text">@string/privacidade_editar</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Título de seção (ícone + texto) -->
    <style name="TituloSecaoPerfil">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/nunito_black</item>
        <item name="android:textColor">@color/azul_titulo</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Opção do diagnóstico -->
    <style name="CheckDiagnostico">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:button">@drawable/checkbox_diag_selector</item>
        <!-- sem tint do Material: o desenho já tem as cores do Figma -->
        <item name="buttonTint">@null</item>
        <item name="useMaterialThemeColors">false</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:minHeight">18dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textColor">@color/text_check_privacidade</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Bottom navigation: sem a "pílula" de fundo no item selecionado (como no Figma) -->
    <style name="Widget.App.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>